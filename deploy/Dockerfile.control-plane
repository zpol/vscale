FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOTOOLCHAIN=local
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/vscale-control-plane ./cmd/control-plane

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/vscale-control-plane /usr/local/bin/vscale-control-plane
EXPOSE 8080
ENTRYPOINT ["vscale-control-plane"]
