FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOTOOLCHAIN=local
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/vscale ./cmd/vscale

FROM alpine:3.20
RUN apk add --no-cache ca-certificates coreutils bash wireguard-tools iptables iproute2
COPY --from=build /out/vscale /usr/local/bin/vscale
ENTRYPOINT ["vscale"]
